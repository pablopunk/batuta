---
const MODIFIERS = ["⌃", "⌥", "⌘"];

const DIRECTIONS = [
  { letter: "H", arrow: "←", action: "focus left" },
  { letter: "J", arrow: "↓", action: "stage down" },
  { letter: "K", arrow: "↑", action: "stage up" },
  { letter: "L", arrow: "→", action: "focus right" },
];
---

<figure class="keys" data-direction-keys>
  <div class="modifiers">
    {MODIFIERS.map((symbol) => <kbd data-modifier={symbol} class:list={{ off: symbol === "⌥" }}>{symbol}</kbd>)}
    <span>+</span>
  </div>
  <div class="direction-row">
    {
      DIRECTIONS.map(({ letter, arrow, action }) => (
        <div class="direction">
          <div class="direction-keys">
            <kbd class="big" data-letter>{letter}</kbd>
            <kbd class="big off" data-arrow>{arrow}</kbd>
          </div>
          <span class="action">{action}</span>
        </div>
      ))
    }
  </div>
</figure>

<script>
  const MODIFIER_SETS = [["⌃", "⌘"], ["⌥", "⌘"], ["⌃", "⌥"], ["⌃", "⌥", "⌘"]];
  const STEP_MS = 1600;
  const PRESS_MS = 260;

  const pressBriefly = (key: HTMLElement) => {
    key.classList.add("pressed");
    setTimeout(() => key.classList.remove("pressed"), PRESS_MS);
  };

  const animate = (figure: HTMLElement) => {
    const modifierKeys = [...figure.querySelectorAll<HTMLElement>("[data-modifier]")];
    const letterKeys = [...figure.querySelectorAll<HTMLElement>("[data-letter]")];
    const arrowKeys = [...figure.querySelectorAll<HTMLElement>("[data-arrow]")];
    let modifierSet = 0;
    let showsArrows = false;
    let changesKeysNext = true;

    const toggleDirectionKeys = () => {
      showsArrows = !showsArrows;
      const shown = showsArrows ? arrowKeys : letterKeys;
      const hidden = showsArrows ? letterKeys : arrowKeys;
      hidden.forEach((key) => key.classList.add("off"));
      shown.forEach((key) => {
        key.classList.remove("off");
        pressBriefly(key);
      });
    };

    const nextModifierSet = () => {
      modifierSet = (modifierSet + 1) % MODIFIER_SETS.length;
      const held = MODIFIER_SETS[modifierSet];
      modifierKeys.forEach((key) => {
        const isHeld = held.includes(key.dataset.modifier ?? "");
        if (isHeld && key.classList.contains("off")) pressBriefly(key);
        key.classList.toggle("off", !isHeld);
      });
    };

    setInterval(() => {
      if (changesKeysNext) toggleDirectionKeys();
      else nextModifierSet();
      changesKeysNext = !changesKeysNext;
    }, STEP_MS);
  };

  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-direction-keys]").forEach(animate);
  }
</script>

<style>
  .keys {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding: 40px 24px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
  }
  kbd {
    display: grid;
    place-items: center;
    overflow: hidden;
    min-width: 44px;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-bottom-width: 3px;
    border-radius: 9px;
    background: var(--page);
    font: 600 18px -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    color: var(--text);
    transition: width 0.25s ease, min-width 0.25s ease, margin 0.25s ease, opacity 0.25s ease, transform 0.12s ease, border-bottom-width 0.12s ease;
  }
  kbd.off { min-width: 0; width: 0; margin: 0 -4px; opacity: 0; border-width: 0; }
  kbd.pressed { transform: translateY(2px); border-bottom-width: 1px; }
  kbd.big { min-width: 68px; width: 68px; height: 68px; font-size: 26px; }
  kbd.big.off { min-width: 0; width: 0; margin: 0; }
  .direction-keys { display: flex; }
  .modifiers { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 20px; }
  .direction-row { display: flex; gap: 14px; }
  .direction { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .action { font-size: 12px; color: var(--muted); }

  @media (max-width: 760px) {
    kbd.big { min-width: 56px; width: 56px; height: 56px; font-size: 22px; }
    kbd.big.off { min-width: 0; width: 0; margin: 0; }
    .direction-row { gap: 10px; }
  }
</style>
