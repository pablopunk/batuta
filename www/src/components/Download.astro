---
const DOWNLOAD_URL = "https://github.com/pablopunk/batuta/releases/latest/download/Batuta.zip";
---

<section class="download">
  <a class="download-button" href={DOWNLOAD_URL}>
    <img src="/icon.png" alt="" width="44" height="44" />
    <span>Download for macOS</span>
  </a>
</section>

<style>
  .download {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 64px 0 40px;
  }
  .download-button {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 14px 32px 14px 16px;
    border-radius: 999px;
    background: var(--text);
    color: var(--page);
    font-size: 22px;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
    box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--text) 50%, transparent);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .download-button:hover { transform: translateY(-2px); box-shadow: 0 22px 46px -18px color-mix(in srgb, var(--text) 60%, transparent); }
  .download-button:active { transform: translateY(0); }
  .download-button img { border-radius: 10px; }

  @media (max-width: 640px) {
    .download-button { font-size: 18px; padding: 12px 24px 12px 12px; }
    .download-button img { width: 36px; height: 36px; }
  }
</style>
