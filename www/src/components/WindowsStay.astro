---
const SCREENS = [
  { name: "Other tiling managers", verdict: "Snaps back", stays: false },
  { name: "Batuta", verdict: "Stays where you put it", stays: true },
];

const CODE_LINES = [
  [12, "kw"], [30, "fn"], [22, ""], [36, "str"], [18, ""], [0, ""], [26, "kw"], [40, "fn"], [16, "str"], [28, ""],
] as const;

const CHAT = [
  { mine: false, width: 60 }, { mine: true, width: 45 }, { mine: false, width: 70 }, { mine: true, width: 35 },
];

const PHOTO_HUES = [210, 330, 30, 150, 270, 0];

const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const EVENTS: [day: number, start: number, length: number, hue: number][] = [
  [0, 10, 18, 210], [1, 30, 22, 150], [2, 6, 14, 330], [3, 40, 26, 30], [4, 16, 20, 270], [5, 52, 16, 0], [6, 24, 30, 190],
];
---

<figure class="windows-stay">
  {
    SCREENS.map(({ name, verdict, stays }) => (
      <div class:list={["screen-card", { stays }]}>
        <div class="screen">
          <div class="ws-window ws-editor">
            <div class="ws-titlebar"><i /><i /><i /></div>
            <div class="ws-code">
              {CODE_LINES.map(([indent, kind], index) => (
                <span class={kind && `ws-${kind}`} style={`width: ${kind ? 20 + ((index * 17) % 40) : 30}%; margin-left: ${indent / 4}%`} />
              ))}
            </div>
          </div>
          <div class="ws-window ws-chat">
            <div class="ws-titlebar"><i /><i /><i /></div>
            <div class="ws-bubbles">
              {CHAT.map(({ mine, width }) => <span class:list={{ "ws-mine": mine }} style={`width: ${width}%`} />)}
            </div>
          </div>
          <div class="ws-window ws-photos">
            <div class="ws-titlebar"><i /><i /><i /></div>
            <div class="ws-grid">
              {PHOTO_HUES.map((hue) => <span style={`--hue: ${hue}`} />)}
            </div>
          </div>
          <div class="ws-window ws-calendar">
            <div class="ws-titlebar"><i /><i /><i /></div>
            <div class="ws-week">
              {DAYS.map((day, dayIndex) => (
                <div class="ws-day">
                  <b>{day}</b>
                  {EVENTS.filter(([eventDay]) => eventDay === dayIndex).map(([, start, length, hue]) => (
                    <span style={`top: ${start}%; height: ${length}%; --hue: ${hue}`} />
                  ))}
                </div>
              ))}
            </div>
          </div>
          <div class="ws-pointer" />
        </div>
        <figcaption>
          <b>{name}</b>
          <span>{verdict}</span>
        </figcaption>
      </div>
    ))
  }
</figure>

<style>
  .windows-stay {
    --cycle: 10s;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .screen-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
  }
  .screen {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: linear-gradient(135deg, light-dark(#c7d2fe, #312e81), light-dark(#fbcfe8, #831843));
  }

  .ws-window {
    position: absolute;
    width: 47%;
    height: 45.5%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 1.6cqw;
    background: var(--page);
    box-shadow: 0 1.5cqw 4cqw -1.5cqw rgba(0, 0, 0, 0.5);
  }
  .ws-editor { left: 2%; top: 3%; }
  .ws-chat { left: 51%; top: 3%; }
  .ws-photos { left: 2%; top: 51.5%; }
  .ws-calendar { left: 51%; top: 51.5%; z-index: 1; }
  .ws-titlebar {
    flex: none;
    display: flex;
    gap: 0.8cqw;
    padding: 1cqw 1.4cqw;
    border-bottom: 1px solid var(--line);
  }
  .ws-titlebar i { width: 1.4cqw; height: 1.4cqw; border-radius: 50%; background: #ff5f57; }
  .ws-titlebar i:nth-child(2) { background: #febc2e; }
  .ws-titlebar i:nth-child(3) { background: #28c840; }

  .ws-code { display: flex; flex-direction: column; gap: 1.2cqw; padding: 1.8cqw; }
  .ws-code span { height: 1cqw; border-radius: 1cqw; background: color-mix(in srgb, var(--muted) 45%, transparent); }
  .ws-code .ws-kw { background: light-dark(#c026d3, #e879f9); }
  .ws-code .ws-fn { background: light-dark(#2563eb, #60a5fa); }
  .ws-code .ws-str { background: light-dark(#dc2626, #fca5a5); }

  .ws-bubbles { display: flex; flex-direction: column; gap: 1.2cqw; padding: 1.8cqw; }
  .ws-bubbles span { height: 3.2cqw; border-radius: 1.6cqw; background: color-mix(in srgb, var(--muted) 25%, transparent); }
  .ws-bubbles .ws-mine { align-self: flex-end; background: #0a84ff; }

  .ws-grid { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8cqw; padding: 1.4cqw; }
  .ws-grid span { border-radius: 0.8cqw; background: hsl(var(--hue) 25% 50% / 0.35); }

  .ws-week {
    flex: 1;
    width: 74cqw;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.6cqw;
    padding: 1.2cqw;
  }
  .ws-day {
    position: relative;
    border-left: 1px solid var(--line);
    padding-top: 3cqw;
  }
  .ws-day b {
    position: absolute;
    top: 0;
    left: 0.6cqw;
    font-size: 1.6cqw;
    font-weight: 600;
    color: var(--muted);
  }
  .ws-day span {
    position: absolute;
    left: 0.6cqw;
    right: 0.4cqw;
    margin-top: 3cqw;
    border-radius: 0.6cqw;
    background: hsl(var(--hue) 75% 60% / 0.85);
  }

  .ws-editor { animation: editor var(--cycle) ease-in-out infinite; }
  .ws-chat { animation: chat var(--cycle) ease-in-out infinite; }
  .ws-photos { animation: photos var(--cycle) ease-in-out infinite; }
  .ws-calendar { animation: snap-back var(--cycle) ease-in-out infinite; }
  .stays .ws-calendar { animation-name: stay; }
  .ws-pointer {
    position: absolute;
    z-index: 2;
    left: 90%;
    top: 92%;
    width: 7cqw;
    height: 7cqw;
    margin: -3.5cqw 0 0 -3.5cqw;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.35);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(4px);
    animation: pointer var(--cycle) ease-in-out infinite;
  }
  figcaption { display: flex; flex-direction: column; gap: 2px; font-size: 14px; }
  figcaption span { color: var(--muted); font-size: 13px; }
  .stays figcaption span { color: light-dark(#15803d, #4ade80); }

  @keyframes pointer {
    0%, 16% { left: 90%; top: 92%; transform: scale(1); }
    24% { left: 74.5%; top: 54%; transform: scale(1); }
    26%, 33% { transform: scale(0.75); }
    26% { left: 74.5%; top: 54%; }
    33% { left: 35.5%; top: 20.5%; }
    35% { transform: scale(1); }
    41% { left: 59%; top: 63.5%; transform: scale(1); }
    43%, 50% { transform: scale(0.75); }
    43% { left: 59%; top: 63.5%; }
    50% { left: 90%; top: 82%; }
    52% { transform: scale(1); }
    60%, 100% { left: 90%; top: 92%; transform: scale(1); }
  }
  @keyframes editor {
    0%, 8% { left: 2%; top: 3%; width: 30.67%; height: 94%; }
    13%, 90% { left: 2%; top: 3%; width: 47%; height: 45.5%; }
    95%, 100% { left: 2%; top: 3%; width: 30.67%; height: 94%; }
  }
  @keyframes chat {
    0%, 8% { left: 34.67%; top: 3%; width: 30.67%; height: 94%; }
    13%, 90% { left: 51%; top: 3%; width: 47%; height: 45.5%; }
    95%, 100% { left: 34.67%; top: 3%; width: 30.67%; height: 94%; }
  }
  @keyframes photos {
    0%, 8% { left: 67.33%; top: 3%; width: 30.67%; height: 94%; }
    13%, 90% { left: 2%; top: 51.5%; width: 47%; height: 45.5%; }
    95%, 100% { left: 67.33%; top: 3%; width: 30.67%; height: 94%; }
  }
  @keyframes snap-back {
    0%, 8% { left: 51%; top: 51.5%; width: 47%; height: 45.5%; opacity: 0; transform: scale(0.9); }
    13%, 26% { left: 51%; top: 51.5%; width: 47%; height: 45.5%; opacity: 1; transform: scale(1); }
    33%, 43% { left: 12%; top: 18%; width: 47%; height: 45.5%; }
    50%, 52% { left: 12%; top: 18%; width: 78%; height: 64%; }
    54%, 90% { left: 51%; top: 51.5%; width: 47%; height: 45.5%; opacity: 1; }
    93%, 100% { left: 51%; top: 51.5%; width: 47%; height: 45.5%; opacity: 0; }
  }
  @keyframes stay {
    0%, 8% { left: 51%; top: 51.5%; width: 47%; height: 45.5%; opacity: 0; transform: scale(0.9); }
    13%, 26% { left: 51%; top: 51.5%; width: 47%; height: 45.5%; opacity: 1; transform: scale(1); }
    33%, 43% { left: 12%; top: 18%; width: 47%; height: 45.5%; }
    50%, 90% { left: 12%; top: 18%; width: 78%; height: 64%; opacity: 1; }
    93%, 100% { left: 12%; top: 18%; width: 78%; height: 64%; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ws-window, .ws-pointer { animation: none; }
    .stays .ws-calendar { left: 12%; top: 18%; width: 78%; height: 64%; }
  }
  @media (max-width: 480px) {
    .windows-stay { grid-template-columns: 1fr; }
  }
</style>
