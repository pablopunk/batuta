---
const TITLE = "Batuta: keyboard control for macOS Stage Manager";
const DESCRIPTION =
  "Batuta adds keyboard shortcuts and tiling to macOS Stage Manager. Switch stages, move windows between them and tile them without touching the mouse. Free and open source.";
const SITE_NAME = "Batuta";
const REPO_URL = "https://github.com/pablopunk/batuta";
const DOWNLOAD_URL = `${REPO_URL}/releases/latest`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = { url: new URL("/og.png", Astro.site), width: 1200, height: 630, alt: "Batuta tiling windows in macOS Stage Manager" };

const softwareApplication = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE_NAME,
  description: DESCRIPTION,
  url: canonicalUrl.href,
  image: ogImage.url.href,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "macOS",
  downloadUrl: DOWNLOAD_URL,
  installUrl: DOWNLOAD_URL,
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Pablo P Varela", url: "https://github.com/pablopunk" },
  sameAs: [REPO_URL],
};
---

<title>{TITLE}</title>
<meta name="description" content={DESCRIPTION} />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" href="/icon.png" />
<link rel="apple-touch-icon" href="/icon.png" />
<link rel="sitemap" href="/sitemap.xml" />
<meta name="theme-color" content="#f7f7fa" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0b0c10" media="(prefers-color-scheme: dark)" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={TITLE} />
<meta property="og:description" content={DESCRIPTION} />
<meta property="og:image" content={ogImage.url} />
<meta property="og:image:width" content={ogImage.width} />
<meta property="og:image:height" content={ogImage.height} />
<meta property="og:image:alt" content={ogImage.alt} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content="@pablopunk" />
<meta name="twitter:title" content={TITLE} />
<meta name="twitter:description" content={DESCRIPTION} />
<meta name="twitter:image" content={ogImage.url} />
<meta name="twitter:image:alt" content={ogImage.alt} />

<script type="application/ld+json" set:html={JSON.stringify(softwareApplication)} />
